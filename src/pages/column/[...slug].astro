---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import {
  getAllColumns,
  extractHeadingsAndAddIds,
  formatJSTDate,   // 🌟 追加
  toJSTYearMonth,  // 🌟 追加
  type Column,
} from "../../library/microcms";

// 🌟 このページはビルド時に生成するようAstroに指示します
export const prerender = true;

export async function getStaticPaths() {
  const allColumns = await getAllColumns();
  return allColumns.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: Column;
}

const { entry } = Astro.props;

// 🌟 リッチエディタのHTMLからh2/h3を抽出し、id付きHTMLに変換
const { html: contentHtml, headings } = extractHeadingsAndAddIds(
  entry.content,
);

const allColumns = await getAllColumns();

// 👇 ここから追加：サイドバー用のデータ抽出処理
// カテゴリ一覧の抽出
const categories = Array.from(
  new Map(
    allColumns
      .filter((entry) => entry.category)
      .map((entry) => [entry.category!.id, entry.category!.name]),
  ).values(),
).sort();

const yearMonths = Array.from(
  new Set(allColumns.map((entry) => toJSTYearMonth(new Date(entry.date)))),
).sort((a, b) => (a < b ? 1 : -1)); // 新しい月が上に来るように降順

// 関連記事：同じカテゴリから、この記事以外を新しい順に3件
const related = allColumns
  .filter((c) => c.id !== entry.id && c.category?.id === entry.category?.id)
  .sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf())
  .slice(0, 3);


// h2/h3見出しのみを目次に使う
const tocHeadings = headings.filter((h) => h.depth <= 3);
---

<BaseLayout
  title={`${entry.title} | コラム | 足立税理士事務所`}
  description={entry.description ?? entry.excerpt}
>
 <div class="container column-layout-wrapper">
    
    <!-- ＝＝＝ 左側：記事本文と執筆者情報 ＝＝＝ -->
    <main class="column-main">
      <article class="column-article">
        <!-- 記事の横幅をサイドバーに合わせて広げるため class="container narrow" を外しています -->
       
       <div class="breadcrumb-wrap">
  <Breadcrumb
    parentLinks={[{ name: "コラム", url: "/column" }]}
    currentPage={entry.title}
  />
</div>

        <span class="article-category-tag">{entry.category?.name ?? "未分類"}</span>
        <h1 class="article-title">{entry.title}</h1>
       <p class="article-date">
  公開日：{formatJSTDate(new Date(entry.date))}
  {
    formatJSTDate(new Date(entry.updatedAt)) !==
      formatJSTDate(new Date(entry.date)) && (
      <span class="article-date-updated">
        （更新日：{formatJSTDate(new Date(entry.updatedAt))}）
      </span>
    )
  }
</p>

        <div class="article-thumb">
          <img src={entry.eyecatch?.url} alt="" />
        </div>

        {
          tocHeadings.length > 1 && (
            <nav class="article-toc">
              <p class="article-toc-title">
                <i class="ph-bold ph-list-bullets" /> 目次
              </p>
              <ul>
                {tocHeadings.map((h) => (
                  <li class={`toc-depth-${h.depth}`}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }

        <div class="article-body">
          <Fragment set:html={contentHtml} />
        </div>
      </article>

      <!-- 執筆者情報（左側の下部に配置） -->
      <section class="author-section">
  <div class="author-card">
    <p class="author-label">この記事を書いた人</p>
    <div class="author-card-body">
      <div class="author-avatar">
        <i class="ph-bold ph-user"></i>
      </div>
      <div class="author-info">
        <p class="author-name">足立 太郎（あだち たろう）</p>
        <p class="author-title">足立税理士事務所 代表税理士</p>
      </div>
      <div class="author-link-btn-wrap">
        <a href="/about#profile" class="author-link-btn">
          プロフィールを見る
          <i class="ph-bold ph-arrow-right btn-arrow-icon anim-arrow"></i>
        </a>
      </div>
    </div>
  </div>
</section>
    </main>

    <!-- ＝＝＝ 右側：サイドバー ＝＝＝ -->
    <aside class="column-sidebar">
      
      <!-- カテゴリ一覧 -->
      <div class="sidebar-widget">
        <h3 class="widget-title">カテゴリ</h3>
        <ul class="widget-list">
          {categories.map((c) => (
            <li>
              <!-- 👇ここがポイント：一覧ページにパラメーター付きで飛ぶ -->
              <a href={`/column?category=${c}`}>
                <i class="ph-bold ph-caret-right"></i>
                {c}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- アーカイブ（年月）一覧 -->
      <div class="sidebar-widget">
        <h3 class="widget-title">アーカイブ</h3>
        <ul class="widget-list">
          {yearMonths.map((ym) => {
            const [y, m] = ym.split("-");
            const label = `${y}年${Number(m)}月`;
            return (
              <li>
                <!-- 👇ここがポイント：一覧ページにパラメーター付きで飛ぶ -->
                <a href={`/column?month=${ym}`}>
                  <i class="ph-bold ph-caret-right"></i>
                  {label}
                </a>
              </li>
            );
          })}
        </ul>
      </div>

    </aside>
  </div>


  <!-- 関連記事 -->
  {
    related.length > 0 && (
      <section class="related-section">
        <div class="container">
          <h2 class="sub-section-title">関連記事</h2>
          <div class="related-grid">
            {related.map((r) => (
              <a href={`/column/${r.id}`} class="related-card">
                <div class="related-thumb">
                  <img src={r.eyecatch?.url} alt="" loading="lazy" />
                </div>
                <p class="related-title">{r.title}</p>
                <p class="related-date">{formatJSTDate(new Date(r.date))}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

 
</BaseLayout>

<style>
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px;
    width: 100%;
    box-sizing: border-box;
  }

  .column-article {
    padding: 0 0 20px;
  }

  .breadcrumb-wrap {
   width: 100%;
    align-self: flex-start;
    margin-bottom: 50px;
    display: flex;
    justify-content: flex-start;
}

  .article-category-tag {
    display: inline-block;
    background: var(--primary-color, #0f8b8d);
    color: #ffffff;
    font-size: 12px;
    font-weight: bold;
    padding: 5px 14px;
    border-radius: 999px;
    margin-bottom: 16px;
    
  }
  .article-title {
    font-size: 28px;
    font-weight: bold;
    color: #222222;
    line-height: 1.5;
    margin: 0 0 12px;
  }
  .article-date {
    font-size: 13px;
    color: #999999;
    margin: 0 0 30px;
  }
  .article-date-updated {
    margin-left: 8px;
  }

  .article-thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 40px;
    background: #f4fafb;
    border: 1px solid #eaeaea;
  }
  .article-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .article-toc {
    background: #f4fafb;
    border-radius: 10px;
    padding: 22px 26px;
    margin-bottom: 40px;
  }
  .article-toc-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 14px;
    font-weight: bold;
    color: #222222;
    margin: 0 0 12px;
  }
  .article-toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .article-toc a {
    font-size: 13.5px;
    color: var(--primary-color, #0f8b8d);
    text-decoration: none;
  }
  .article-toc a:hover {
    text-decoration: underline;
  }
  .toc-depth-3 {
    padding-left: 18px;
  }

  .article-body {
    font-size: 15.5px;
    color: #333333;
    line-height: 1.9;
  }
  .article-body :global(h2) {
    font-size: 21px;
    font-weight: bold;
    color: #222222;
    margin: 48px 0 18px;
    scroll-margin-top: 100px;
  }
  .article-body :global(h3) {
    font-size: 17px;
    font-weight: bold;
    color: #222222;
    margin: 32px 0 14px;
    scroll-margin-top: 100px;
  }
  .article-body :global(p) {
    margin: 0 0 20px;
  }
  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 20px;
    padding-left: 24px;
  }
  .article-body :global(img) {
    max-width: 100%;
    border-radius: 8px;
    margin: 24px 0;
  }

  /* 執筆者情報 */
  .author-section {
    padding: 0 0 60px;
  }
  .author-card {
  background: #f4fafb;
  border-radius: 10px;
  padding: 24px 28px;
}
.author-info {
  flex: 0 1 auto; /* flex: 1 をやめる。中身の文字幅だけを取る */
}
  .author-label {
  font-size: 13px;
  font-weight: bold;
  color: #0f8b8d; /* 目立たせるためprimary-colorに変更 */
  margin: 0 0 16px;
  padding-bottom: 12px;
  border-bottom: 1px solid #d8e8e8; /* 区切り線を追加 */
  letter-spacing: 0.05em;
}
.author-card-body {
  display: flex;
  align-items: center;
  gap: 20px;
  justify-content: flex-start
}
  .author-avatar {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #d1e6f3;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .author-avatar i {
    font-size: 26px;
    color: #1e4b7a;
  }
  .author-name {
    font-size: 15px;
    font-weight: bold;
    color: #222222;
    margin: 0 0 4px;
  }
  .author-title {
    font-size: 13px;
    color: #666666;
    margin: 0 0 8px;
  }
   .author-link-btn-wrap {
  flex-shrink: 0; /* ← 追加：ボタンが縮まないように */
  text-align: left;
}

  .author-link-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1.5px solid var(--primary-color, #0f8b8d);
    color: var(--primary-color, #0f8b8d) !important;
    text-decoration: none;
    font-size: 13px;
    font-weight: bold;
    padding: 9px 20px;
    border-radius: 4px;
    transition: all 0.3s;
    background-color: #ffffff !important;
    min-width: auto;
  }

  .author-link-btn:hover {
    background: var(--primary-color, #0f8b8d) !important;
    color: #ffffff !important;
  }

  /* 関連記事 */
  .related-section {
    padding: 20px 0 70px;
    background: #ffffff;
  }
  .sub-section-title {
    text-align: center;
    font-size: 24px;
    color: #222;
    margin: 0 0 32px;
    position: relative;
    padding-bottom: 15px;
    font-weight: bold;
  }
  .sub-section-title::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 3px;
    background: var(--primary-color, #0f8b8d);
    border-radius: 2px;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .related-card {
    text-decoration: none;
    color: inherit;
  }
  .related-thumb {
    width: 100%;
    aspect-ratio: 5 / 3;
    border-radius: 8px;
    overflow: hidden;
    background: #f4fafb;
    margin-bottom: 10px;
    border: 1px solid #eaeaea;
  }
  .related-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  .related-card:hover .related-thumb img {
    transform: scale(1.05);
  }
  .related-title {
    font-size: 14px;
    font-weight: bold;
    color: #222222;
    line-height: 1.5;
    margin: 0 0 6px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .related-date {
    font-size: 12px;
    color: #999999;
    margin: 0;
  }

  /* CTA */
  .cta-section {
    background: var(--primary-color, #0f8b8d);
    text-align: center;
    padding: 60px 20px;
  }
  .cta-title {
    font-size: 20px;
    font-weight: bold;
    color: #ffffff;
    margin: 0 0 10px;
  }
  .cta-text {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.9);
    margin: 0 0 26px;
  }
  .btn-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    color: var(--primary-color, #0f8b8d) !important;
    text-decoration: none;
    font-weight: bold;
    font-size: 14px;
    padding: 14px 36px;
    border-radius: 4px;
    transition: transform 0.2s ease;
  }
  .btn-cta:hover {
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .article-title {
      font-size: 22px;
    }
    .related-grid {
      grid-template-columns: 1fr 1fr;
    }
    
    .author-label {
    text-align: center;
  }
    .author-card-body {
    flex-direction: column;
    text-align: center;
  }
  }
  @media (max-width: 480px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
  /* ==========================================
     追加：2カラムレイアウト設定
     ========================================== */
  .column-layout-wrapper {
    display: flex;
  gap: 50px;
  padding-top: 24px; /* 他ページのヒーローエリアと余白を統一 */
  align-items: flex-start;
  }

  .column-main {
    flex: 1; /* 左側は余った幅をすべて使う */
    min-width: 0; /* テキストのはみ出しを防止 */
  }

  /* ==========================================
     追加：サイドバーのデザイン
     ========================================== */
  .column-sidebar {
    width: 250px; /* サイドバーの固定幅 */
    flex-shrink: 0; /* 画面が狭くなってもサイドバーは縮めない */
    display: flex;
    flex-direction: column;
    gap: 32px; /* ウィジェット(カテゴリとアーカイブ)同士の隙間 */
    margin-top: 50px; /* ← ここを追加。サイドバーの開始位置を下げる */
  }

  .sidebar-widget {
    background: #f4fafb; /* サイト全体のトーンに合わせた薄い水色 */
    border-radius: 10px;
    padding: 24px;
  }

  .widget-title {
    font-size: 16px;
    font-weight: bold;
    color: #222222;
    margin: 0 0 16px 0;
    padding-bottom: 12px;
    border-bottom: 2px solid #e2eeee;
    text-align: center;
  }

  .widget-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .widget-list li {
    border-bottom: 1px dashed #e2eeee; /* リストの区切り線 */
  }

  .widget-list li:last-child {
    border-bottom: none;
  }

  .widget-list a {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 0;
    font-size: 14px;
    color: #444444;
    text-decoration: none;
    transition: color 0.2s;
  }

  .widget-list a i {
    color: var(--primary-color, #0f8b8d);
    font-size: 12px;
  }

  .widget-list a:hover {
    color: var(--primary-color, #0f8b8d);
    font-weight: bold; /* ホバー時に少し目立たせる */
  }

  /* ==========================================
     追加：スマホ・タブレット時のレスポンシブ対応
     ========================================== */
  @media (max-width: 960px) {
    .column-layout-wrapper {
      flex-direction: column; /* 縦並びに変更 */
      gap: 60px; /* 縦に並んだ時の隙間 */
    }
    .column-sidebar {
      width: 100%; /* サイドバーを横幅いっぱいにする */
       margin-top: -70px; /* ← 追加：縦並びでは不要な余白なのでリセット */
    }
  }
</style>