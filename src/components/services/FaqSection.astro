---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<section class="info-faq-section">
  <div class="container">
    <h2 class="section-title">よくある質問</h2>
    <div class="faq-list">
      {
        items.map((item) => (
          <div class="faq-item">
            <p class="faq-q">
              <span>Q.</span> {item.q}
            </p>
            <p class="faq-a">{item.a}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .info-faq-section {
    background: #ffffff;
    padding: 90px 0 100px;
  }
  .faq-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
    gap: 24px;
    max-width: 1100px;
    margin: 0 auto;
    align-items: start;
  }
  .faq-item {
    background: #f4fafb;
    border: 1px solid #eee;
    border-radius: 6px;
    padding: 24px;
  }
  .faq-q {
    font-size: 15px;
    font-weight: bold;
    color: #222;
    margin: 0 0 10px 0;
    display: flex;
    gap: 8px;
  }
  .faq-q span {
    color: var(--primary-color, #0f8b8d);
  }
  .faq-a {
    font-size: 14px;
    color: #555;
    line-height: 1.6;
    margin: 0;
  }
  @media (max-width: 992px) {
    .faq-list {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
  @media (max-width: 768px) {
    .info-faq-section {
      padding: 60px 0;
    }
    .section-title {
      font-size: 24px;
    }
  }
</style>
