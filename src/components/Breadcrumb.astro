---
interface Props {
  parentLinks?: { name: string; url: string }[];
  currentPage: string;
  type?: "default" | "transparent";
}

const { parentLinks = [], currentPage, type = "transparent" } = Astro.props;
---

<ol
  class={`breadcrumb ${type === "default" ? "is-default" : "is-transparent"}`}
>
  <li><a href="/">ホーム</a></li>
  {
    parentLinks.map((link) => (
      <li>
        <a href={link.url}>{link.name}</a>
      </li>
    ))
  }
  <li><span>{currentPage}</span></li>
</ol>

<style>
  .breadcrumb {
    display: inline-flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    font-size: 14px; /* 文字サイズを14pxに完全固定 */
    font-weight: 500;
    color: #666666;
  }

  /* 透過スタイル（画像・アイコン共にこちらを使用） */
  .breadcrumb.is-transparent {
    padding: 0;
    background: transparent;
    backdrop-filter: none;
  }

  /* ボックススタイル（他のページで必要な場合用） */
  .breadcrumb.is-default {
    padding: 6px 14px;
    background-color: rgba(255, 255, 255, 0.6);
    border-radius: 6px;
    backdrop-filter: blur(2px);
  }

  .breadcrumb li {
    display: flex;
    align-items: center;
  }

  .breadcrumb li:not(:last-child)::after {
    content: "/";
    margin: 0 10px;
    font-size: 13px;
    color: #8fa3a3;
  }

  .breadcrumb a {
    color: #4a5555;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb a:hover {
    color: var(--primary-color, #008080);
    text-decoration: underline;
  }

  .breadcrumb span {
    color: #333333;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .breadcrumb {
      font-size: 12px;
    }
  }
</style>
